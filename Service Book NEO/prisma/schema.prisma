generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  affiliation   String?   // 所属
  zip           String?   // 郵便番号
  address       String?   // 所在地
  phoneNumber   String?   // 連絡先
  fax           String?   // FAX
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  areas         UserArea[]
  assignedRequests Request[] @relation("AssignedRequests")
}

model UserArea {
  id         String   @id @default(cuid())
  userId     String
  prefecture String
  cities     String?  // JSON stringified array of city names
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, prefecture])
}

model Account {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  kana      String?
  zip       String?
  address1  String?
  address2  String?
  address   String?   // Keep for migration backup
  plusCode  String?
  phone1    String?
  phone2    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  email     String?
  requests  Request[]
}

model Request {
  id                   Int           @id @default(autoincrement())
  status               String        @default("PENDING")
  primeName            String?
  primeZip             String?
  primeAddr            String?
  primeTel             String?
  primeFax             String?
  primeMobile          String?
  primeEmail           String?
  reqName              String?
  reqZip               String?
  reqAddr1             String?
  reqAddr2             String?
  reqAddr              String?       // Keep for migration backup
  reqTel               String?
  reqFax               String?
  reqMobile            String?
  reqEmail             String?
  reqManager           String?       // 依頼元担当者
  customerId           Int?
  customerName         String?
  customerAddress1     String?
  customerAddress2     String?
  customerAddress      String?       // Keep for migration backup
  deviceModel          String?
  gasType              String?
  lotNumber            String?
  yearsUsed            String?
  yearsUsedInt         Int?
  requestContent       String?
  internalNotes        String?
  isReported           Boolean       @default(false)
  orderNumber          String?
  cause                String?
  treatment            String?
  billingBreakdown     String?
  reportDate           DateTime      @default(now())
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  billingAddress1      String?
  billingAddress2      String?
  billingAddress       String?       // Keep for migration backup
  billingFax           String?
  billingName          String?
  billingTel           String?
  billingZip           String?
  completedAt          DateTime?
  customerEmail        String?
  customerPlusCode     String?
  customerTel1         String?
  customerTel2         String?
  customerZip          String?
  deviceManufacturer   String?
  managementNumber     String?       @unique
  pescManagementNumber String?
  receivedAt           DateTime?
  billingKana          String?
  customerKana         String?
  primeKana            String?
  reqKana              String?
  billingItems         BillingItem[]
  customer             Customer?     @relation(fields: [customerId], references: [id])
  assignedUserId       String?
  assignedUser         User?         @relation("AssignedRequests", fields: [assignedUserId], references: [id])
  sitePhotoUrl         String?
}

model BillingItem {
  id        Int     @id @default(autoincrement())
  requestId Int
  name      String
  unitPrice Int
  quantity  Int
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}
